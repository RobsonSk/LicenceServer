# Porta do servidor Node.js
PORT=8443

# Define se o servidor Node usa HTTPS próprio (true) ou HTTP puro para rodar atrás do pfSense/HAProxy (false)
USE_HTTPS=false

# (Opcional) Chave de API exigida no cabeçalho 'X-API-Key' do programa externo.
CLIENT_API_KEY=sua_chave_api_cliente_aqui

# Chave secreta para geração de tokens JWT do painel administrativo
JWT_SECRET=sua_chave_secreta_jwt_aqui

# URL base do servidor de licenciamento (URL pública do pfSense / Nginx / HAProxy)
LICENSE_SERVER_URL=https://licenciamento.suaempresa.com.br

# Caminho do banco de dados SQLite
DATABASE_PATH=./licenses.db
