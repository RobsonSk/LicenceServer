<html>
<head>
  <title>Licenses</title>
</head>
<body>
  <h1>Licenses</h1>
  <a href="/licenses/add">Add License</a>
  <form action="/licenses/delete-all" method="POST" style="display:inline;">
    <button type="submit" onclick="return confirm('Are you sure you want to delete ALL licenses?')">Delete All</button>
  </form>
  <table border="1">
    <tr>
      <th>UUID</th><th>Company</th><th>CNPJ</th><th>Phone</th><th>Email</th><th>Created</th><th>Valid Until</th><th>Actions</th>
    </tr>
    {{#each licenses}}
    <tr>
      <td>{{uuid}}</td>
      <td>{{company_name}}</td>
      <td>{{cnpj}}</td>
      <td>{{phone}}</td>
      <td>{{email}}</td>
      <td>{{created_at}}</td>
      <td>{{valid_until}}</td>
      <td>
        <a href="/licenses/edit/{{uuid}}">Edit</a>
        <form action="/licenses/delete/{{uuid}}" method="POST" style="display:inline;">
          <button type="submit" onclick="return confirm('Delete this license?')">Delete</button>
        </form>
        {{#if client_cert}}
          | <a href="/licenses/download-cert/{{uuid}}">Download Cert</a>
          | <a href="/licenses/download-key/{{uuid}}">Download Key</a>
        {{/if}}
        {{#if hasEncryptedConfig}}
          | <a href="/licenses/download-config/{{uuid}}">Download Config</a>
        {{/if}}
      </td>
    </tr>
    {{/each}}
  </table>
</body>
</html>
