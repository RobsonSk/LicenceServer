  /* Buscar e Renderizar Licenças com Botão de Cópia e Reset Abaixo */
  async function fetchLicenses() {
    try {
      const res = await fetch('/api/admin/licenses', {
        headers: { 'Authorization': `Bearer ${token}` }
      });

      if (res.status === 401 || res.status === 403) {
        logoutAdmin();
        return;
      }

      const data = await res.json();
      const tbody = document.getElementById('licensesTableBody');

      if (!data.licenses || data.licenses.length === 0) {
        tbody.innerHTML = `<tr><td colspan="8" style="padding: 2rem; text-align: center; color: var(--text-muted);">Nenhuma licença cadastrada.</td></tr>`;
        return;
      }

      const now = new Date();
      tbody.innerHTML = data.licenses.map(lic => {
        const isLifetime = lic.is_lifetime === 1 || lic.valid_until === 'LIFETIME';
        const validUntil = isLifetime ? null : new Date(lic.valid_until);
        const isExpired = !isLifetime && validUntil && validUntil <= now;

        let statusBadge = '<span style="background: rgba(34, 197, 94, 0.15); color: var(--accent-green); padding: 4px 8px; border-radius: 6px; font-weight: 600; font-size: 0.75rem;">Ativo</span>';
        if (lic.status === 'revoked') {
          statusBadge = '<span style="background: rgba(239, 68, 68, 0.15); color: var(--accent-red); padding: 4px 8px; border-radius: 6px; font-weight: 600; font-size: 0.75rem;">Desativado</span>';
        } else if (isExpired) {
          statusBadge = '<span style="background: rgba(234, 179, 8, 0.15); color: var(--accent-yellow); padding: 4px 8px; border-radius: 6px; font-weight: 600; font-size: 0.75rem;">Expirado</span>';
        }

        // Exibir simplesmente "Vitalício" ou a data formatada
        let dateDisplay = '<span style="color: var(--accent-blue); font-weight: 600;">Vitalício</span>';
        if (!isLifetime && validUntil) {
          dateDisplay = validUntil.toLocaleString('pt-BR');
        }

        // HWID mascarado com asteriscos e botão resetar alinhado abaixo
        let hwidDisplay = '<span style="color: var(--text-muted); font-size: 0.75rem;">⚪ Livre (1º acesso)</span>';
        if (lic.hwid && lic.hwid.trim() !== '') {
          let resetBtn = '';
          if (loggedRole === 'admin' || loggedRole === 'operator') {
            resetBtn = `<button onclick="resetHwidAction('${lic.uuid}')" class="btn btn-secondary" style="padding: 2px 6px; font-size: 0.7rem;" title="Desvincular HWID desta máquina">🔄 Resetar</button>`;
          }
          hwidDisplay = `
            <div style="display: flex; flex-direction: column; align-items: flex-start; gap: 4px;">
              <span style="background: rgba(34, 197, 94, 0.12); color: var(--accent-green); padding: 3px 7px; border-radius: 6px; font-family: monospace; font-size: 0.75rem; font-weight: 600; letter-spacing: 1px;" title="${escapeHtml(lic.hwid)}">🔒 ••••••••••••••••</span>
              ${resetBtn}
            </div>
          `;
        }

        let actionBtns = '';
        if (loggedRole === 'admin') {
          actionBtns = `
            <div style="display: flex; justify-content: flex-end; align-items: center; gap: 6px; flex-wrap: nowrap;">
              <button onclick="openEditModal('${lic.uuid}', '${escapeHtml(lic.company_name)}', '${lic.valid_until}', ${isLifetime ? 'true' : 'false'}, '${lic.status || 'active'}')" class="btn btn-secondary" style="padding: 4px 10px; font-size: 0.8rem;">Editar</button>
              <button onclick="deleteLicense('${lic.uuid}')" class="btn btn-danger" style="padding: 4px 10px; font-size: 0.8rem;">Excluir</button>
            </div>
          `;
        } else if (loggedRole === 'operator') {
          actionBtns = `
            <div style="display: flex; justify-content: flex-end; align-items: center; gap: 6px; flex-wrap: nowrap;">
              <button onclick="openEditModal('${lic.uuid}', '${escapeHtml(lic.company_name)}', '${lic.valid_until}', ${isLifetime ? 'true' : 'false'}, '${lic.status || 'active'}')" class="btn btn-secondary" style="padding: 4px 10px; font-size: 0.8rem;">Editar</button>
            </div>
          `;
        } else {
          actionBtns = `<span style="color: var(--text-muted); font-size: 0.75rem;">Somente Leitura</span>`;
        }

        return `
          <tr style="border-bottom: 1px solid var(--border-color);">
            <td style="padding: 1rem;">
              <strong style="color: var(--text-main); font-size: 0.95rem;">${escapeHtml(lic.company_name)}</strong>
            </td>
            <td style="padding: 1rem;">
              <div style="display: flex; flex-direction: column; align-items: flex-start; gap: 4px;">
                <code style="background: var(--bg-input); padding: 4px 8px; border-radius: 6px; font-family: monospace; font-size: 0.85rem; color: var(--accent-blue); font-weight: 600; letter-spacing: 1px;">••••••••-••••-••••</code>
                <button onclick="copyToClipboard('${lic.uuid}', 'UUID copiado!')" class="btn btn-secondary" style="padding: 2px 6px; font-size: 0.7rem; white-space: nowrap;" title="Copiar UUID Completo">📋 Copiar</button>
              </div>
            </td>
            <td style="padding: 1rem;">
              <div style="display: flex; flex-direction: column; align-items: flex-start; gap: 4px;">
                <code style="background: var(--bg-input); padding: 4px 8px; border-radius: 6px; font-family: monospace; font-size: 0.85rem; color: #cbd5e1; font-weight: 600; letter-spacing: 1px;">••••••••••••••••</code>
                <button onclick="copyToClipboard('${lic.api_key || ''}', 'X-API-Key copiada!')" class="btn btn-secondary" style="padding: 2px 6px; font-size: 0.7rem; white-space: nowrap;" title="Copiar Key Completa">📋 Copiar Key</button>
              </div>
            </td>
            <td style="padding: 1rem;">${hwidDisplay}</td>
            <td style="padding: 1rem;">${statusBadge}</td>
            <td style="padding: 1rem; color: var(--text-muted);">${dateDisplay}</td>
            <td style="padding: 1rem; color: var(--text-muted); font-size: 0.85rem;"><span style="color: var(--accent-blue); font-weight: 600;">${escapeHtml(lic.created_by || 'Sistema')}</span></td>
            <td style="padding: 1rem; text-align: right;">${actionBtns}</td>
          </tr>
        `;
      }).join('');

    } catch (err) {
      console.error(err);
    }
  }

  async function resetHwidAction(uuid) {
    if (loggedRole === 'user') return;
    if (!confirm('Deseja desvincular o HWID desta licença? O próximo computador que tentar validar esta licença será registrado como o novo computador oficial.')) return;
    try {
      const res = await fetch(`/api/admin/licenses/${uuid}/reset-hwid`, {
        method: 'POST',
        headers: { 'Authorization': `Bearer ${token}` }
      });
      const data = await res.json();
      if (data.success) {
        showToast('HWID desvinculado com sucesso!');
        fetchLicenses();
      } else {
        alert('Erro: ' + data.error);
      }
    } catch (err) {
      alert('Erro ao desvincular HWID.');
    }
  }

  function escapeHtml(str) {
    if (!str) return '';
    return str.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;').replace(/'/g, '&#39;');
  }

  function openAddModal() {
    document.getElementById('modalTitle').textContent = 'Nova Licença';
    document.getElementById('editUuid').value = '';
    document.getElementById('company_name').value = '';
    document.getElementById('is_lifetime').checked = false;
    document.getElementById('status').value = 'active';
    toggleLifetime(false);

    const defaultDate = new Date(Date.now() + 30 * 24 * 60 * 60 * 1000);
    const tzOffset = defaultDate.getTimezoneOffset() * 60000;
    const localIso = new Date(defaultDate.getTime() - tzOffset).toISOString().slice(0, 16);
    document.getElementById('valid_until').value = localIso;

    document.getElementById('licenseModal').style.display = 'flex';
  }

  function openEditModal(uuid, name, validUntilIso, isLifetime, status) {
    document.getElementById('modalTitle').textContent = 'Editar Licença';
    document.getElementById('editUuid').value = uuid;
    document.getElementById('company_name').value = name;
    document.getElementById('is_lifetime').checked = isLifetime;
    document.getElementById('status').value = status;
    toggleLifetime(isLifetime);

    if (!isLifetime && validUntilIso && validUntilIso !== 'LIFETIME') {
      const dateObj = new Date(validUntilIso);
      const tzOffset = dateObj.getTimezoneOffset() * 60000;
      const localIso = new Date(dateObj.getTime() - tzOffset).toISOString().slice(0, 16);
      document.getElementById('valid_until').value = localIso;
    }

    document.getElementById('licenseModal').style.display = 'flex';
  }

  function closeModal() {
    document.getElementById('licenseModal').style.display = 'none';
  }

  document.getElementById('licenseForm').addEventListener('submit', async (e) => {
    e.preventDefault();
    const uuid = document.getElementById('editUuid').value;
    const isLifetime = document.getElementById('is_lifetime').checked;
    
    const payload = {
      company_name: document.getElementById('company_name').value,
      is_lifetime: isLifetime,
      valid_until: isLifetime ? 'LIFETIME' : new Date(document.getElementById('valid_until').value).toISOString(),
      status: document.getElementById('status').value
    };

    const method = uuid ? 'PUT' : 'POST';
    const url = uuid ? `/api/admin/licenses/${uuid}` : '/api/admin/licenses';

    try {
      const res = await fetch(url, {
        method,
        headers: {
          'Content-Type': 'application/json',
          'Authorization': `Bearer ${token}`
        },
        body: JSON.stringify(payload)
      });

      const data = await res.json();
      if (data.success) {
        closeModal();
        showToast(uuid ? 'Licença atualizada!' : 'Nova licença criada com sucesso!');
        fetchLicenses();
      } else {
        alert('Erro: ' + (data.error || 'Não foi possível salvar a licença.'));
      }
    } catch (err) {
      alert('Erro de conexão ao salvar licença.');
    }
  });

  document.getElementById('passwordForm').addEventListener('submit', async (e) => {
    e.preventDefault();
    const currentPassword = document.getElementById('currentPassword').value;
    const newPassword = document.getElementById('newPassword').value;
    const confirmPassword = document.getElementById('confirmPassword').value;

    try {
      const res = await fetch('/api/admin/change-password', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'Authorization': `Bearer ${token}`
        },
        body: JSON.stringify({ currentPassword, newPassword, confirmPassword })
      });

      const data = await res.json();
      if (data.success) {
        closePasswordModal();
        showToast('Senha alterada com sucesso!');
      } else {
        alert('Erro: ' + (data.error || 'Não foi possível alterar a senha.'));
      }
    } catch (err) {
      alert('Erro ao alterar senha.');
    }
  });

  async function deleteLicense(uuid) {
    if (loggedRole !== 'admin') return;
    if (!confirm('Tem certeza que deseja excluir esta licença? O programa externo deixará de ter acesso.')) return;

    try {
      const res = await fetch(`/api/admin/licenses/${uuid}`, {
        method: 'DELETE',
        headers: { 'Authorization': `Bearer ${token}` }
      });
      const data = await res.json();
      if (data.success) {
        showToast('Licença excluída!');
        fetchLicenses();
      } else {
        alert('Erro: ' + data.error);
      }
    } catch (err) {
      alert('Erro ao excluir licença.');
    }
  }

  /* Buscar e Renderizar Logs de Acesso com Distinção Visual de Origem (Painel Web vs Validação API) */
  async function fetchAccessLogs() {
    if (loggedRole === 'user') return;
    try {
      const res = await fetch('/api/admin/access-logs', {
        headers: { 'Authorization': `Bearer ${token}` }
      });
      const data = await res.json();
      allAccessLogs = data.logs || [];
      logsPage = 1;
      renderAccessLogsTable();
    } catch (err) {
      console.error('Erro ao buscar logs:', err);
    }
  }

  function renderAccessLogsTable() {
    const tbody = document.getElementById('logsTableBody');
    const pageInfo = document.getElementById('logsPageInfo');
    const pageNum = document.getElementById('logsPageNum');
    const btnPrev = document.getElementById('btnPrevLogs');
    const btnNext = document.getElementById('btnNextLogs');

    if (!allAccessLogs || allAccessLogs.length === 0) {
      tbody.innerHTML = `<tr><td colspan="7" style="padding: 1.5rem; text-align: center; color: var(--text-muted);">Nenhuma tentativa de acesso negado registrada.</td></tr>`;
      pageInfo.textContent = 'Mostrando 0 de 0 tentativas';
      pageNum.textContent = 'Página 1 de 1';
      btnPrev.disabled = true;
      btnNext.disabled = true;
      return;
    }

    const totalPages = Math.ceil(allAccessLogs.length / LOGS_PER_PAGE) || 1;
    if (logsPage > totalPages) logsPage = totalPages;
    if (logsPage < 1) logsPage = 1;

    const startIdx = (logsPage - 1) * LOGS_PER_PAGE;
    const endIdx = Math.min(startIdx + LOGS_PER_PAGE, allAccessLogs.length);
    const pageLogs = allAccessLogs.slice(startIdx, endIdx);

    tbody.innerHTML = pageLogs.map(log => {
      let originBadge = '';
      let cleanReason = log.reason || '';

      if (cleanReason.includes('[Painel Web]') || (log.endpoint && log.endpoint.includes('/admin'))) {
        originBadge = '<span style="background: rgba(168, 85, 247, 0.18); color: #c084fc; padding: 2px 7px; border-radius: 5px; font-weight: 700; font-size: 0.72rem; margin-right: 6px; display: inline-block;">🌐 Painel Web</span>';
        cleanReason = cleanReason.replace('[Painel Web]', '').trim();
      } else if (cleanReason.includes('[Validação API]') || (log.endpoint && log.endpoint.includes('/validate'))) {
        originBadge = '<span style="background: rgba(59, 130, 246, 0.18); color: #60a5fa; padding: 2px 7px; border-radius: 5px; font-weight: 700; font-size: 0.72rem; margin-right: 6px; display: inline-block;">🔑 Validação API</span>';
        cleanReason = cleanReason.replace('[Validação API]', '').trim();
      }

      return `
        <tr style="border-bottom: 1px solid var(--border-color);">
          <td style="padding: 0.75rem 1rem; color: var(--text-muted); font-size: 0.8rem;">${new Date(log.created_at).toLocaleString('pt-BR')}</td>
          <td style="padding: 0.75rem 1rem;"><code style="color: var(--accent-yellow); font-family: monospace; font-weight: 600;">${escapeHtml(log.ip)}</code></td>
          <td style="padding: 0.75rem 1rem;"><code style="color: var(--accent-blue); font-family: monospace;">••••••••-••••-••••</code></td>
          <td style="padding: 0.75rem 1rem;"><code style="color: #cbd5e1; font-family: monospace;">••••••••••••••••</code></td>
          <td style="padding: 0.75rem 1rem;">
            ${originBadge}
            <span style="color: #ef4444; font-weight: 600;">${escapeHtml(cleanReason)}</span>
          </td>
          <td style="padding: 0.75rem 1rem; color: var(--text-muted); font-size: 0.75rem;" title="${escapeHtml(log.user_agent)}">${escapeHtml((log.user_agent || '').substring(0, 25))}${(log.user_agent || '').length > 25 ? '...' : ''}</td>
          <td style="padding: 0.75rem 1rem; text-align: right;">
            <div style="display: flex; justify-content: flex-end; align-items: center; gap: 6px;">
              ${(log.ip && log.ip !== 'desconhecido' && log.ip !== '127.0.0.1') ? `<button onclick="openBlockIpModal('${escapeHtml(log.ip)}', 'Bloqueado a partir dos logs de auditoria')" class="btn btn-danger" style="padding: 3px 8px; font-size: 0.75rem;" title="Bloquear IP ${escapeHtml(log.ip)}">🚫 Bloquear IP</button>` : '<span style="color: var(--text-muted); font-size: 0.75rem;">Localhost</span>'}
            </div>
          </td>
        </tr>
      `;
    }).join('');

    pageInfo.textContent = `Mostrando ${startIdx + 1}-${endIdx} de ${allAccessLogs.length} tentativas`;
    pageNum.textContent = `Página ${logsPage} de ${totalPages}`;
    btnPrev.disabled = (logsPage <= 1);
    btnNext.disabled = (logsPage >= totalPages);
  }

  function changeLogsPage(delta) {
    logsPage += delta;
    renderAccessLogsTable();
  }

  async function clearAccessLogs() {
    if (loggedRole !== 'admin') return;
    if (!confirm('Deseja limpar todo o histórico de tentativas de acesso negado?')) return;
    try {
      const res = await fetch('/api/admin/access-logs', {
        method: 'DELETE',
        headers: { 'Authorization': `Bearer ${token}` }
      });
      const data = await res.json();
      if (data.success) {
        showToast('Logs de acesso limpos!');
        fetchAccessLogs();
      }
    } catch (err) {
      alert('Erro ao limpar logs.');
    }
  }

  /* Listagem de Blacklist de IPs com Registro de Histórico de Desbloqueios */
  async function fetchBlockedIps() {
    if (loggedRole === 'user') return;
    try {
      const res = await fetch('/api/admin/blocked-ips', {
        headers: { 'Authorization': `Bearer ${token}` }
      });
      const data = await res.json();
      const tbody = document.getElementById('blockedIpsTableBody');
      if (!data.blockedIps || data.blockedIps.length === 0) {
        tbody.innerHTML = `<tr><td colspan="6" style="padding: 1.5rem; text-align: center; color: var(--text-muted);">Nenhum IP no histórico de bloqueios.</td></tr>`;
        return;
      }

      tbody.innerHTML = data.blockedIps.map(item => {
        const isUnblocked = item.status === 'unblocked' || (item.unblocked_at && item.unblocked_at.trim() !== '');

        let statusBadge = '<span style="background: rgba(239, 68, 68, 0.15); color: #ef4444; padding: 4px 8px; border-radius: 6px; font-weight: 600; font-size: 0.75rem;">🔴 Bloqueado</span>';
        if (isUnblocked) {
          statusBadge = '<span style="background: rgba(34, 197, 94, 0.15); color: var(--accent-green); padding: 4px 8px; border-radius: 6px; font-weight: 600; font-size: 0.75rem;">🟢 Desbloqueado</span>';
        }

        const blockedInfo = `<strong style="color: var(--accent-blue); font-size: 0.8rem;">${escapeHtml(item.blocked_by || 'Sistema')}</strong><br><span style="color: var(--text-muted); font-size: 0.75rem;">${new Date(item.created_at).toLocaleString('pt-BR')}</span>`;

        let unblockedInfo = '<span style="color: var(--text-muted); font-size: 0.75rem;">-</span>';
        if (isUnblocked) {
          unblockedInfo = `<strong style="color: var(--accent-green); font-size: 0.8rem;">${escapeHtml(item.unblocked_by || 'Sistema')}</strong><br><span style="color: var(--text-muted); font-size: 0.75rem;">${new Date(item.unblocked_at).toLocaleString('pt-BR')}</span>`;
        }

        let actionBtn = '';
        if (isUnblocked) {
          actionBtn = `<button onclick="openBlockIpModal('${escapeHtml(item.ip)}', '${escapeHtml(item.reason || '')}')" class="btn btn-danger" style="padding: 4px 10px; font-size: 0.75rem;">🚫 Re-Bloquear IP</button>`;
        } else {
          actionBtn = `<button onclick="unblockIpAction('${escapeHtml(item.ip)}')" class="btn btn-secondary" style="padding: 4px 10px; font-size: 0.75rem;">✅ Desbloquear IP</button>`;
        }

        return `
          <tr style="border-bottom: 1px solid var(--border-color);">
            <td style="padding: 0.75rem 1rem;"><code style="color: ${isUnblocked ? 'var(--text-muted)' : '#ef4444'}; font-family: monospace; font-weight: 700; font-size: 0.9rem;">${escapeHtml(item.ip)}</code></td>
            <td style="padding: 0.75rem 1rem;">${statusBadge}</td>
            <td style="padding: 0.75rem 1rem; color: var(--text-main);">${escapeHtml(item.reason)}</td>
            <td style="padding: 0.75rem 1rem;">${blockedInfo}</td>
            <td style="padding: 0.75rem 1rem;">${unblockedInfo}</td>
            <td style="padding: 0.75rem 1rem; text-align: right;">
              <div style="display: flex; justify-content: flex-end; align-items: center; gap: 6px;">
                ${actionBtn}
              </div>
            </td>
          </tr>
        `;
      }).join('');
    } catch (err) {
      console.error('Erro ao buscar IPs bloqueados:', err);
    }
  }

  /* Funções para Modal de Bloqueio de IP */
  function openBlockIpModal(ip = '', reason = '') {
    if (loggedRole === 'user') return;
    document.getElementById('blockIpInput').value = ip;
    document.getElementById('blockIpReasonInput').value = reason || 'Tentativas suspeitas de ataque';
    document.getElementById('blockIpModal').style.display = 'flex';
  }

  function closeBlockIpModal() {
    document.getElementById('blockIpModal').style.display = 'none';
  }

  document.getElementById('blockIpForm').addEventListener('submit', async (e) => {
    e.preventDefault();
    const ip = document.getElementById('blockIpInput').value.trim();
    const reason = document.getElementById('blockIpReasonInput').value.trim();

    if (!ip) return;

    try {
      const res = await fetch('/api/admin/block-ip', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'Authorization': `Bearer ${token}` },
        body: JSON.stringify({ ip, reason })
      });
      const data = await res.json();
      if (data.success) {
        closeBlockIpModal();
        showToast(`IP ${ip} bloqueado com sucesso!`);
        fetchBlockedIps();
        fetchAccessLogs();
      } else {
        alert('Erro: ' + data.error);
      }
    } catch (err) {
      alert('Erro ao bloquear IP.');
    }
  });

  async function unblockIpAction(ip) {
    if (loggedRole === 'user') return;
    if (!confirm(`Tem certeza que deseja desbloquear o IP ${ip}? O registro será mantido com data e responsável pelo desbloqueio.`)) return;
    try {
      const res = await fetch('/api/admin/unblock-ip', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'Authorization': `Bearer ${token}` },
        body: JSON.stringify({ ip })
      });
      const data = await res.json();
      if (data.success) {
        showToast(`IP ${ip} desbloqueado!`);
        fetchBlockedIps();
      } else {
        alert('Erro: ' + data.error);
      }
    } catch (err) {
      alert('Erro ao desbloquear IP.');
    }
  }
</script>
