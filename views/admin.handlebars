        alert('Erro: ' + (data.error || 'Código incorreto.'));
      }
    } catch (err) {
      alert('Erro ao ativar MFA.');
    }
  });

  async function disableMfaAction() {
    const pwd = prompt('Por segurança, digite a sua senha atual para confirmar a desativação do MFA:');
    if (!pwd) return;

    try {
      const res = await fetch('/api/admin/mfa/disable', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'Authorization': `Bearer ${token}`
        },
        body: JSON.stringify({ currentPassword: pwd })
      });
      const data = await res.json();
      if (data.success) {
        showToast('MFA Desativado com sucesso.');
        checkMfaStatus();
        fetchUsers();
      } else {
        alert('Erro: ' + data.error);
      }
    } catch (err) {
      alert('Erro ao desativar MFA.');
    }
