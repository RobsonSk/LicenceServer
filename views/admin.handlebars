<!-- Modal para Adicionar / Editar Licença -->
<div id="licenseModal" style="display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.7); align-items: center; justify-content: center; z-index: 999;">
  <div class="card" style="width: 100%; max-width: 480px; margin: 0 1rem; position: relative;">
    <button type="button" onclick="closeModal()" style="position: absolute; top: 16px; right: 18px; background: transparent; border: none; color: var(--text-muted); font-size: 1.25rem; font-weight: 700; cursor: pointer; line-height: 1; transition: color 0.2s;" title="Fechar Modal">✕</button>
    <h3 id="modalTitle" style="margin-bottom: 1.25rem;">Nova Licença</h3>
    <form id="licenseForm">
      <input type="hidden" id="editUuid">
      
      <div class="form-group">
        <label>Nome / Identificação do Cliente</label>
        <input type="text" id="company_name" class="form-control" placeholder="Ex: Cliente Empresa XYZ" required>
      </div>

      <div class="form-group" style="flex-direction: row; align-items: center; gap: 10px; margin-bottom: 1rem;">
        <input type="checkbox" id="is_lifetime" style="width: 18px; height: 18px; cursor: pointer;" onchange="toggleLifetime(this.checked)">
        <label for="is_lifetime" style="cursor: pointer; margin: 0; font-size: 0.95rem; color: var(--accent-blue); font-weight: 600;">
          ♾️ Válido para Sempre (Sem Expiração)
        </label>
      </div>

      <div class="form-group" id="validUntilGroup">
        <label>Data e Hora de Validade</label>
        <input type="datetime-local" id="valid_until" class="form-control">
      </div>

      <div class="form-group">
        <label>Status da Licença</label>
        <select id="status" class="form-control">
          <option value="active">Ativo (Permitir acesso)</option>
          <option value="revoked">Desativado / Revogado (Bloquear acesso)</option>
        </select>
      </div>

      <div style="display: flex; justify-content: flex-end; gap: 10px; margin-top: 1.5rem;">
        <button type="button" onclick="closeModal()" class="btn btn-secondary">Cancelar</button>
        <button type="submit" class="btn btn-primary">Salvar Licença</button>
      </div>
    </form>
  </div>
</div>

<!-- Modal para Bloquear IP Manualmente -->
<div id="blockIpModal" style="display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.7); align-items: center; justify-content: center; z-index: 999;">
  <div class="card" style="width: 100%; max-width: 440px; margin: 0 1rem; position: relative;">
    <button type="button" onclick="closeBlockIpModal()" style="position: absolute; top: 16px; right: 18px; background: transparent; border: none; color: var(--text-muted); font-size: 1.25rem; font-weight: 700; cursor: pointer; line-height: 1; transition: color 0.2s;" title="Fechar Modal">✕</button>
    <h3 style="margin-bottom: 1.25rem; color: #ef4444; display: flex; align-items: center; gap: 8px;">🚫 Bloquear Endereço IP</h3>
    <form id="blockIpForm">
      <div class="form-group">
        <label>Endereço IP</label>
        <input type="text" id="blockIpInput" class="form-control" placeholder="Ex: 198.51.100.45" required>
      </div>
      <div class="form-group">
        <label>Motivo do Bloqueio</label>
        <input type="text" id="blockIpReasonInput" class="form-control" placeholder="Ex: Tentativas de ataque ou força bruta" required>
      </div>
      <div style="display: flex; justify-content: flex-end; gap: 10px; margin-top: 1.5rem;">
        <button type="button" onclick="closeBlockIpModal()" class="btn btn-secondary">Cancelar</button>
        <button type="submit" class="btn btn-danger">Confirmar Bloqueio</button>
      </div>
    </form>
  </div>
</div>

<!-- Modal de Perfil: Alterar Senha & Gerenciar MFA -->
<div id="passwordModal" style="display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.7); align-items: center; justify-content: center; z-index: 999;">
  <div class="card" style="width: 100%; max-width: 480px; margin: 0 1rem; position: relative;">
    <button type="button" onclick="closePasswordModal()" style="position: absolute; top: 16px; right: 18px; background: transparent; border: none; color: var(--text-muted); font-size: 1.25rem; font-weight: 700; cursor: pointer; line-height: 1; transition: color 0.2s;" title="Fechar Modal">✕</button>
    <h3 style="margin-bottom: 1.25rem;">🔑 Meu Perfil - Senha & MFA</h3>
    <form id="passwordForm">
      <div class="form-group">
        <label>Senha Atual</label>
        <input type="password" id="currentPassword" class="form-control" placeholder="••••••••" required>
      </div>
      <div class="form-group">
        <label>Nova Senha</label>
        <input type="password" id="newPassword" class="form-control" placeholder="Digite a nova senha" required oninput="onPasswordInputLive()">
      </div>
      <div class="form-group" style="margin-bottom: 0.75rem;">
        <label>Confirmação da Nova Senha</label>
        <input type="password" id="confirmPassword" class="form-control" placeholder="Repita a nova senha" required oninput="onPasswordInputLive()">
      </div>

      <!-- Requisitos Dinâmicos em Tempo Real -->
      <div style="margin-bottom: 1.25rem;">
        <div style="font-size: 0.75rem; color: var(--text-muted); font-weight: 600; margin-bottom: 6px;">Requisitos da Senha:</div>
        <div style="display: flex; flex-wrap: wrap; gap: 6px; font-size: 0.75rem;">
          <span id="pwd-len" style="padding: 3px 8px; border-radius: 6px; background: rgba(239, 68, 68, 0.15); color: #ef4444; font-weight: 600; transition: all 0.2s;">🔴 8+ caracteres</span>
          <span id="pwd-upper" style="padding: 3px 8px; border-radius: 6px; background: rgba(239, 68, 68, 0.15); color: #ef4444; font-weight: 600; transition: all 0.2s;">🔴 Maiúscula</span>
          <span id="pwd-lower" style="padding: 3px 8px; border-radius: 6px; background: rgba(239, 68, 68, 0.15); color: #ef4444; font-weight: 600; transition: all 0.2s;">🔴 Minúscula</span>
          <span id="pwd-digit" style="padding: 3px 8px; border-radius: 6px; background: rgba(239, 68, 68, 0.15); color: #ef4444; font-weight: 600; transition: all 0.2s;">🔴 Número</span>
          <span id="pwd-special" style="padding: 3px 8px; border-radius: 6px; background: rgba(239, 68, 68, 0.15); color: #ef4444; font-weight: 600; transition: all 0.2s;">🔴 Especial (@#$!)</span>
        </div>
        <div id="pwd-match" style="margin-top: 8px; font-size: 0.8rem; font-weight: 600; color: #ef4444; display: none;"></div>
      </div>

      <div style="display: flex; justify-content: flex-end; gap: 10px; margin-bottom: 1.5rem;">
        <button type="button" onclick="closePasswordModal()" class="btn btn-secondary">Cancelar</button>
        <button type="submit" class="btn btn-primary">Atualizar Senha</button>
      </div>
    </form>

    <hr style="border: 0; border-top: 1px solid var(--border-color); margin-bottom: 1.25rem;">

    <!-- Seção de Gerenciamento de MFA (2FA TOTP) no Perfil -->
    <div style="display: flex; justify-content: space-between; align-items: center;">
      <div>
        <h4 style="font-size: 0.95rem; font-weight: 700; color: var(--text-main); margin-bottom: 2px;">📱 Autenticação em Duas Etapas (MFA)</h4>
        <p style="font-size: 0.78rem; color: var(--text-muted); margin: 0;">Proteja seu acesso com Google Authenticator ou Authy.</p>
      </div>
      <div id="mfaProfileBtnContainer">
        <span style="font-size: 0.75rem; color: var(--text-muted);">Carregando status...</span>
      </div>
    </div>
  </div>
</div>

<!-- Modal para Configurar MFA (QR Code) -->
<div id="mfaSetupModal" style="display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.7); align-items: center; justify-content: center; z-index: 1000;">
  <div class="card" style="width: 100%; max-width: 440px; margin: 0 1rem; text-align: center; position: relative;">
    <button type="button" onclick="closeMfaSetupModal()" style="position: absolute; top: 16px; right: 18px; background: transparent; border: none; color: var(--text-muted); font-size: 1.25rem; font-weight: 700; cursor: pointer; line-height: 1; transition: color 0.2s;" title="Fechar Modal">✕</button>
    <h3 style="margin-bottom: 1rem; color: var(--accent-blue);">📱 Configurar Autenticação MFA</h3>
    <p style="font-size: 0.85rem; color: var(--text-muted); margin-bottom: 1rem;">1. Abra o aplicativo <strong>Google Authenticator</strong> ou <strong>Authy</strong> no celular e escaneie o QR Code abaixo:</p>
    
    <div style="background: #fff; padding: 12px; border-radius: 12px; display: inline-block; margin-bottom: 1rem;">
      <img id="mfaQrCodeImg" src="" alt="MFA QR Code" style="width: 180px; height: 180px; display: block;">
    </div>

    <div style="font-size: 0.75rem; color: var(--text-muted); margin-bottom: 1.25rem; word-break: break-all;">
      Chave Manual: <code id="mfaSecretText" style="color: var(--accent-blue); font-family: monospace; font-weight: 700;"></code>
    </div>

    <form id="mfaEnableForm">
      <div class="form-group" style="text-align: left;">
        <label>2. Digite o código de 6 dígitos gerado no aplicativo para ativar:</label>
        <input type="text" id="mfaConfirmCode" class="form-control" placeholder="123456" maxlength="6" pattern="[0-9]{6}" required style="text-align: center; letter-spacing: 4px; font-size: 1.2rem; font-weight: 700; font-family: monospace;">
      </div>

      <div style="display: flex; justify-content: flex-end; gap: 10px; margin-top: 1.25rem;">
        <button type="button" onclick="closeMfaSetupModal()" class="btn btn-secondary">Cancelar</button>
        <button type="submit" class="btn btn-primary">Ativar MFA Agora</button>
      </div>
    </form>
  </div>
</div>

<!-- Modal para Cadastrar Usuário (Apenas Admin) -->
<div id="userModal" style="display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.7); align-items: center; justify-content: center; z-index: 999;">
  <div class="card" style="width: 100%; max-width: 460px; margin: 0 1rem; position: relative;">
    <button type="button" onclick="closeUserModal()" style="position: absolute; top: 16px; right: 18px; background: transparent; border: none; color: var(--text-muted); font-size: 1.25rem; font-weight: 700; cursor: pointer; line-height: 1; transition: color 0.2s;" title="Fechar Modal">✕</button>
    <h3 style="margin-bottom: 1.25rem;">👥 Cadastrar Novo Usuário</h3>
    <form id="userForm">
      <div class="form-group">
        <label>Nome Completo / Visualização</label>
        <input type="text" id="newName" class="form-control" placeholder="Ex: João Silva" required>
      </div>
      <div class="form-group">
        <label>E-mail de Login</label>
        <input type="email" id="newEmail" class="form-control" placeholder="joao.silva@empresa.com" required>
      </div>
      <div class="form-group">
        <label>Função / Perfil (Role)</label>
        <select id="newUserRole" class="form-control">
          <option value="user">Usuário (Somente Leitura - Consulta Licenças)</option>
          <option value="operator">Operador (Criar/Editar Licenças e Gerenciar IPs)</option>
          <option value="admin">Administrador (Acesso Total + Gestão de Usuários)</option>
        </select>
      </div>
      <div class="form-group">
        <label>Senha de Acesso</label>
        <input type="password" id="newUserPassword" class="form-control" placeholder="••••••••" required oninput="onUserPasswordInputLive()">
      </div>
      <div class="form-group" style="margin-bottom: 0.75rem;">
        <label>Confirmar Senha</label>
        <input type="password" id="newUserConfirmPassword" class="form-control" placeholder="••••••••" required oninput="onUserPasswordInputLive()">
      </div>

      <!-- Requisitos Dinâmicos em Tempo Real -->
      <div style="margin-bottom: 1.25rem;">
        <div style="font-size: 0.75rem; color: var(--text-muted); font-weight: 600; margin-bottom: 6px;">Requisitos da Senha:</div>
        <div style="display: flex; flex-wrap: wrap; gap: 6px; font-size: 0.75rem;">
          <span id="usr-pwd-len" style="padding: 3px 8px; border-radius: 6px; background: rgba(239, 68, 68, 0.15); color: #ef4444; font-weight: 600; transition: all 0.2s;">🔴 8+ caracteres</span>
          <span id="usr-pwd-upper" style="padding: 3px 8px; border-radius: 6px; background: rgba(239, 68, 68, 0.15); color: #ef4444; font-weight: 600; transition: all 0.2s;">🔴 Maiúscula</span>
          <span id="usr-pwd-lower" style="padding: 3px 8px; border-radius: 6px; background: rgba(239, 68, 68, 0.15); color: #ef4444; font-weight: 600; transition: all 0.2s;">🔴 Minúscula</span>
          <span id="usr-pwd-digit" style="padding: 3px 8px; border-radius: 6px; background: rgba(239, 68, 68, 0.15); color: #ef4444; font-weight: 600; transition: all 0.2s;">🔴 Número</span>
          <span id="usr-pwd-special" style="padding: 3px 8px; border-radius: 6px; background: rgba(239, 68, 68, 0.15); color: #ef4444; font-weight: 600; transition: all 0.2s;">🔴 Especial (@#$!)</span>
        </div>
        <div id="usr-pwd-match" style="margin-top: 8px; font-size: 0.8rem; font-weight: 600; color: #ef4444; display: none;"></div>
      </div>

      <div style="display: flex; justify-content: flex-end; gap: 10px;">
        <button type="button" onclick="closeUserModal()" class="btn btn-secondary">Cancelar</button>
        <button type="submit" class="btn btn-primary">Salvar Usuário</button>
      </div>
    </form>
  </div>
</div>

<!-- Modal para Editar Usuário / Resetar Senha / Desativar MFA (Apenas Admin) -->
<div id="editUserModal" style="display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.7); align-items: center; justify-content: center; z-index: 999;">
  <div class="card" style="width: 100%; max-width: 460px; margin: 0 1rem; position: relative;">
    <button type="button" onclick="closeEditUserModal()" style="position: absolute; top: 16px; right: 18px; background: transparent; border: none; color: var(--text-muted); font-size: 1.25rem; font-weight: 700; cursor: pointer; line-height: 1; transition: color 0.2s;" title="Fechar Modal">✕</button>
    <h3 style="margin-bottom: 1.25rem;">✏️ Editar Usuário</h3>
    <form id="editUserForm">
      <input type="hidden" id="editUserId">
      <div class="form-group">
        <label>Nome Completo / Visualização</label>
        <input type="text" id="editUserName" class="form-control" required>
      </div>
      <div class="form-group">
        <label>E-mail de Login</label>
        <input type="email" id="editUserEmail" class="form-control" required>
      </div>
      <div class="form-group">
        <label>Função / Perfil (Role)</label>
        <select id="editUserRole" class="form-control">
          <option value="user">Usuário (Somente Leitura - Consulta Licenças)</option>
          <option value="operator">Operador (Criar/Editar Licenças e Gerenciar IPs)</option>
          <option value="admin">Administrador (Acesso Total + Gestão de Usuários)</option>
        </select>
      </div>
      <div class="form-group">
        <label>Nova Senha (Opcional)</label>
        <input type="password" id="editUserPassword" class="form-control" placeholder="Deixe em branco para manter a senha atual">
      </div>

      <div class="form-group" style="flex-direction: row; align-items: center; gap: 10px; margin-top: 1rem; margin-bottom: 1rem;">
        <input type="checkbox" id="editResetMfa" style="width: 18px; height: 18px; cursor: pointer;">
        <label for="editResetMfa" style="cursor: pointer; margin: 0; font-size: 0.85rem; color: #ef4444; font-weight: 600;">
          🔓 Desativar / Resetar Autenticação MFA deste usuário
        </label>
      </div>

      <div style="display: flex; justify-content: flex-end; gap: 10px; margin-top: 1.5rem;">
        <button type="button" onclick="closeEditUserModal()" class="btn btn-secondary">Cancelar</button>
        <button type="submit" class="btn btn-primary">Salvar Alterações</button>
      </div>
    </form>
  </div>
</div>

<script>
  const token = localStorage.getItem('admin_token');
  const loggedUsername = localStorage.getItem('admin_username') || 'admin';
  const loggedName = localStorage.getItem('admin_name') || loggedUsername;
  const loggedRole = localStorage.getItem('admin_role') || 'admin';

  let currentGeneratedMfaSecret = null;
  let allAccessLogs = [];
  let logsPage = 1;
  const LOGS_PER_PAGE = 5;

  if (!token) {
    window.location.href = '/admin/login';
  } else {
    document.getElementById('loggedUser').textContent = loggedName;
    renderRoleBadge(loggedRole);
    applyRolePermissions(loggedRole);
  }

  /* Lógica de Troca de Abas (Tabs) */
  function switchTab(tabName) {
    const tabLicenses = document.getElementById('tabContentLicenses');
    const tabSecurity = document.getElementById('tabContentSecurity');
    const tabUsers = document.getElementById('tabContentUsers');
    const tabSettings = document.getElementById('tabContentSettings');

    const btnLicenses = document.getElementById('tabBtnLicenses');
    const btnSecurity = document.getElementById('tabBtnSecurity');
    const btnUsers = document.getElementById('tabBtnUsers');
    const btnSettings = document.getElementById('tabBtnSettings');

    // Desativar todas as abas
    [btnLicenses, btnSecurity, btnUsers, btnSettings].forEach(btn => {
      if (btn) {
        btn.style.color = 'var(--text-muted)';
        btn.style.borderBottomColor = 'transparent';
      }
    });

    if (tabLicenses) tabLicenses.style.display = 'none';
    if (tabSecurity) tabSecurity.style.display = 'none';
    if (tabUsers) tabUsers.style.display = 'none';
    if (tabSettings) tabSettings.style.display = 'none';

    // Ativar a aba selecionada
    if (tabName === 'licenses') {
      if (tabLicenses) tabLicenses.style.display = 'block';
      if (btnLicenses) {
        btnLicenses.style.color = 'var(--accent-blue)';
        btnLicenses.style.borderBottomColor = 'var(--accent-blue)';
      }
      fetchLicenses();
    } else if (tabName === 'security') {
      if (tabSecurity) tabSecurity.style.display = 'block';
      if (btnSecurity) {
        btnSecurity.style.color = 'var(--accent-blue)';
        btnSecurity.style.borderBottomColor = 'var(--accent-blue)';
      }
      fetchAccessLogs();
      fetchBlockedIps();
    } else if (tabName === 'users') {
      if (tabUsers) tabUsers.style.display = 'block';
      if (btnUsers) {
        btnUsers.style.color = 'var(--accent-blue)';
        btnUsers.style.borderBottomColor = 'var(--accent-blue)';
      }
      fetchUsers();
    } else if (tabName === 'settings') {
      if (tabSettings) tabSettings.style.display = 'block';
      if (btnSettings) {
        btnSettings.style.color = '#c084fc';
        btnSettings.style.borderBottomColor = '#c084fc';
      }
      fetchSystemSettings();
    }
  }

  function renderRoleBadge(role) {
    const badgeSpan = document.getElementById('loggedRoleBadge');
    if (role === 'admin') {
      badgeSpan.innerHTML = '<span style="background: rgba(168, 85, 247, 0.2); color: #c084fc; padding: 3px 8px; border-radius: 6px; font-weight: 700; font-size: 0.75rem;">👑 Administrador</span>';
    } else if (role === 'operator') {
      badgeSpan.innerHTML = '<span style="background: rgba(59, 130, 246, 0.2); color: #60a5fa; padding: 3px 8px; border-radius: 6px; font-weight: 700; font-size: 0.75rem;">🛠️ Operador</span>';
    } else {
      badgeSpan.innerHTML = '<span style="background: rgba(156, 163, 175, 0.2); color: #9ca3af; padding: 3px 8px; border-radius: 6px; font-weight: 700; font-size: 0.75rem;">👤 Usuário (Leitura)</span>';
    }
  }

  function applyRolePermissions(role) {
    const btnAddLicense = document.getElementById('btnAddLicense');
    const tabBtnSecurity = document.getElementById('tabBtnSecurity');
    const tabBtnUsers = document.getElementById('tabBtnUsers');
    const tabBtnSettings = document.getElementById('tabBtnSettings');
    const btnClearLogs = document.getElementById('btnClearLogs');

    if (role === 'admin') {
      if (tabBtnSecurity) tabBtnSecurity.style.display = 'flex';
      if (tabBtnUsers) tabBtnUsers.style.display = 'flex';
      if (tabBtnSettings) tabBtnSettings.style.display = 'flex';
      if (btnAddLicense) btnAddLicense.style.display = 'inline-block';
      if (btnClearLogs) btnClearLogs.style.display = 'inline-block';
    } else if (role === 'operator') {
      if (tabBtnSecurity) tabBtnSecurity.style.display = 'flex';
      if (tabBtnUsers) tabBtnUsers.style.display = 'none';
      if (tabBtnSettings) tabBtnSettings.style.display = 'none';
      if (btnAddLicense) btnAddLicense.style.display = 'inline-block';
      if (btnClearLogs) btnClearLogs.style.display = 'none';
    } else {
      // Perfil 'user' (Somente Leitura)
      if (tabBtnSecurity) tabBtnSecurity.style.display = 'none';
      if (tabBtnUsers) tabBtnUsers.style.display = 'none';
      if (tabBtnSettings) tabBtnSettings.style.display = 'none';
      if (btnAddLicense) btnAddLicense.style.display = 'none';
    }

    switchTab('licenses');
  }

  function showToast(msg) {
    const toast = document.getElementById('toast');
    toast.textContent = msg;
    toast.style.display = 'block';
    setTimeout(() => { toast.style.display = 'none'; }, 3000);
  }

  function logoutAdmin() {
    localStorage.removeItem('admin_token');
    localStorage.removeItem('admin_username');
    localStorage.removeItem('admin_name');
    localStorage.removeItem('admin_role');
    window.location.href = '/admin/login';
  }

  function copyToClipboard(text, successMsg = 'Copiado!') {
    if (!text) return;
    if (navigator.clipboard && window.isSecureContext) {
      navigator.clipboard.writeText(text).then(() => {
        showToast(successMsg);
      }).catch(() => {
        fallbackCopyText(text, successMsg);
      });
    } else {
      fallbackCopyText(text, successMsg);
    }
  }

  function fallbackCopyText(text, successMsg = 'Copiado!') {
    const textArea = document.createElement('textarea');
    textArea.value = text;
    textArea.style.position = 'fixed';
    textArea.style.left = '-999999px';
    textArea.style.top = '-999999px';
    document.body.appendChild(textArea);
    textArea.focus();
    textArea.select();
    try {
      const successful = document.execCommand('copy');
      if (successful) {
        showToast(successMsg);
      } else {
        prompt('Copie manualmente:', text);
      }
    } catch (err) {
      prompt('Copie manualmente:', text);
    }
    document.body.removeChild(textArea);
  }

  function toggleLifetime(checked) {
    const group = document.getElementById('validUntilGroup');
    const input = document.getElementById('valid_until');
    if (checked) {
      group.style.opacity = '0.5';
      input.disabled = true;
      input.removeAttribute('required');
    } else {
      group.style.opacity = '1';
      input.disabled = false;
      input.setAttribute('required', 'required');
    }
  }

  /* Validação Visual de Senha Forte em Tempo Real */
  function onPasswordInputLive() {
    const pwd = document.getElementById('newPassword').value;
    const confirm = document.getElementById('confirmPassword').value;
    updatePasswordChecklist('pwd-', pwd, confirm);
  }

  function onUserPasswordInputLive() {
    const pwd = document.getElementById('newUserPassword').value;
    const confirm = document.getElementById('newUserConfirmPassword').value;
    updatePasswordChecklist('usr-pwd-', pwd, confirm);
  }

  function updatePasswordChecklist(prefix, pwd, confirmVal) {
    updateBadge(`${prefix}len`, pwd.length >= 8, '8+ caracteres');
    updateBadge(`${prefix}upper`, /[A-Z]/.test(pwd), 'Maiúscula');
    updateBadge(`${prefix}lower`, /[a-z]/.test(pwd), 'Minúscula');
    updateBadge(`${prefix}digit`, /[0-9]/.test(pwd), 'Número');
    updateBadge(`${prefix}special`, /[@$!%*?&_#^()\-+=]/.test(pwd), 'Especial (@#$!)');

    const matchEl = document.getElementById(`${prefix}match`);
    if (matchEl) {
      if (!confirmVal && !pwd) {
        matchEl.style.display = 'none';
      } else if (pwd === confirmVal && pwd !== '') {
        matchEl.style.display = 'block';
        matchEl.style.color = 'var(--accent-green)';
        matchEl.textContent = '🟢 Senhas coincidem';
      } else {
        matchEl.style.display = 'block';
        matchEl.style.color = '#ef4444';
        matchEl.textContent = '🔴 As senhas não coincidem';
      }
    }
  }

  function updateBadge(id, isOk, label) {
    const el = document.getElementById(id);
    if (!el) return;
    if (isOk) {
      el.style.background = 'rgba(34, 197, 94, 0.15)';
      el.style.color = 'var(--accent-green)';
      el.textContent = '🟢 ' + label;
    } else {
      el.style.background = 'rgba(239, 68, 68, 0.15)';
      el.style.color = '#ef4444';
      el.textContent = '🔴 ' + label;
    }
  }

  /* Listagem de Usuários com Status MFA */
  async function fetchUsers() {
    if (loggedRole !== 'admin') return;
    try {
      const res = await fetch('/api/admin/users', {
        headers: { 'Authorization': `Bearer ${token}` }
      });
      const data = await res.json();
      const tbody = document.getElementById('usersTableBody');
      if (!data.users || data.users.length === 0) {
        tbody.innerHTML = `<tr><td colspan="6" style="padding: 1.5rem; text-align: center; color: var(--text-muted);">Nenhum usuário cadastrado.</td></tr>`;
        return;
      }
      tbody.innerHTML = data.users.map(u => {
        let rBadge = '<span style="color: #9ca3af;">👤 Usuário</span>';
        if (u.role === 'admin') rBadge = '<span style="color: #c084fc; font-weight: 700;">👑 Admin</span>';
        if (u.role === 'operator') rBadge = '<span style="color: #60a5fa; font-weight: 700;">🛠️ Operador</span>';

        const displayName = u.name || u.username;
        const userEmail = u.email || u.username;

        let mfaBadge = Number(u.mfa_enabled) === 1 
          ? '<span style="background: rgba(34, 197, 94, 0.15); color: var(--accent-green); padding: 3px 8px; border-radius: 6px; font-weight: 600; font-size: 0.75rem;">🟢 MFA Ativo</span>'
          : '<span style="background: rgba(156, 163, 175, 0.15); color: var(--text-muted); padding: 3px 8px; border-radius: 6px; font-size: 0.75rem;">⚪ Inativo</span>';

        return `
          <tr style="border-bottom: 1px solid var(--border-color);">
            <td style="padding: 0.75rem 1rem;">
              <strong style="color: var(--text-main); font-size: 0.9rem;">${escapeHtml(displayName)}</strong>
            </td>
            <td style="padding: 0.75rem 1rem;">
              <code style="color: var(--accent-blue); font-family: monospace; font-size: 0.85rem;">${escapeHtml(userEmail)}</code>
            </td>
            <td style="padding: 0.75rem 1rem;">${rBadge}</td>
            <td style="padding: 0.75rem 1rem;">${mfaBadge}</td>
            <td style="padding: 0.75rem 1rem; color: var(--text-muted); font-size: 0.8rem;">${new Date(u.created_at).toLocaleString('pt-BR')}</td>
            <td style="padding: 0.75rem 1rem; text-align: right;">
              <div style="display: flex; justify-content: flex-end; align-items: center; gap: 6px;">
                <button onclick="openEditUserModal(${u.id}, '${escapeHtml(displayName)}', '${escapeHtml(userEmail)}', '${u.role}')" class="btn btn-secondary" style="padding: 4px 8px; font-size: 0.75rem;">Editar</button>
                ${u.username !== 'admin' ? `<button onclick="deleteUserAction(${u.id}, '${escapeHtml(displayName)}')" class="btn btn-danger" style="padding: 4px 8px; font-size: 0.75rem;">Excluir</button>` : '<span style="color: var(--text-muted); font-size: 0.75rem; margin-left: 4px;">Padrão</span>'}
              </div>
            </td>
          </tr>
        `;
      }).join('');
    } catch (err) {
      console.error('Erro ao buscar usuários:', err);
    }
  }

  function openUserModal() {
    document.getElementById('newName').value = '';
    document.getElementById('newEmail').value = '';
    document.getElementById('newUserPassword').value = '';
    document.getElementById('newUserConfirmPassword').value = '';
    document.getElementById('newUserRole').value = 'user';
    onUserPasswordInputLive();
    document.getElementById('userModal').style.display = 'flex';
  }

  function closeUserModal() {
    document.getElementById('userModal').style.display = 'none';
  }

  function openEditUserModal(id, name, email, role) {
    document.getElementById('editUserId').value = id;
    document.getElementById('editUserName').value = name;
    document.getElementById('editUserEmail').value = email;
    document.getElementById('editUserRole').value = role || 'user';
    document.getElementById('editUserPassword').value = '';
    document.getElementById('editResetMfa').checked = false;
    document.getElementById('editUserModal').style.display = 'flex';
  }

  function closeEditUserModal() {
    document.getElementById('editUserModal').style.display = 'none';
  }

  document.getElementById('editUserForm').addEventListener('submit', async (e) => {
    e.preventDefault();
    const id = document.getElementById('editUserId').value;
    const name = document.getElementById('editUserName').value;
    const email = document.getElementById('editUserEmail').value;
    const role = document.getElementById('editUserRole').value;
    const newPassword = document.getElementById('editUserPassword').value;
    const resetMfa = document.getElementById('editResetMfa').checked;

    try {
      const res = await fetch(`/api/admin/users/${id}`, {
        method: 'PUT',
        headers: {
          'Content-Type': 'application/json',
          'Authorization': `Bearer ${token}`
        },
        body: JSON.stringify({ name, email, role, newPassword, resetMfa })
      });
      const data = await res.json();
      if (data.success) {
        closeEditUserModal();
        showToast('Usuário atualizado com sucesso!');
        fetchUsers();
      } else {
        alert('Erro: ' + (data.error || 'Não foi possível atualizar o usuário.'));
      }
    } catch (err) {
      alert('Erro ao atualizar usuário.');
    }
  });

  document.getElementById('userForm').addEventListener('submit', async (e) => {
    e.preventDefault();
    const name = document.getElementById('newName').value;
    const email = document.getElementById('newEmail').value;
    const password = document.getElementById('newUserPassword').value;
    const confirmPassword = document.getElementById('newUserConfirmPassword').value;
    const role = document.getElementById('newUserRole').value;

    try {
      const res = await fetch('/api/admin/users', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'Authorization': `Bearer ${token}`
        },
        body: JSON.stringify({ name, email, password, confirmPassword, role })
      });

      const data = await res.json();
      if (data.success) {
        closeUserModal();
        showToast('Novo usuário cadastrado com sucesso!');
        fetchUsers();
      } else {
        alert('Erro: ' + (data.error || 'Não foi possível cadastrar o usuário.'));
      }
    } catch (err) {
      alert('Erro ao cadastrar usuário.');
    }
  });

  async function deleteUserAction(id, name) {
    if (!confirm(`Tem certeza que deseja excluir o usuário "${name}"?`)) return;
    try {
      const res = await fetch(`/api/admin/users/${id}`, {
        method: 'DELETE',
        headers: { 'Authorization': `Bearer ${token}` }
      });
      const data = await res.json();
      if (data.success) {
        showToast('Usuário excluído!');
        fetchUsers();
      } else {
        alert('Erro: ' + data.error);
      }
    } catch (err) {
      alert('Erro ao excluir usuário.');
    }
  }

  /* Lógica para Configurações Globais do Serviço */
  async function fetchSystemSettings() {
    if (loggedRole !== 'admin') return;
    try {
      const res = await fetch('/api/admin/settings', {
        headers: { 'Authorization': `Bearer ${token}` }
      });
      const data = await res.json();
      if (data.success && data.settings) {
        document.getElementById('settingRequireMfaAll').checked = !!data.settings.require_mfa_all;
      }
    } catch (err) {
      console.error('Erro ao buscar configurações globais:', err);
    }
  }

  document.getElementById('systemSettingsForm').addEventListener('submit', async (e) => {
    e.preventDefault();
    if (loggedRole !== 'admin') return;
    const require_mfa_all = document.getElementById('settingRequireMfaAll').checked;

    try {
      const res = await fetch('/api/admin/settings', {
        method: 'PUT',
        headers: {
          'Content-Type': 'application/json',
          'Authorization': `Bearer ${token}`
        },
        body: JSON.stringify({ require_mfa_all })
      });
      const data = await res.json();
      if (data.success) {
        showToast(data.message || 'Configurações salvas!');
        fetchSystemSettings();
      } else {
        alert('Erro ao salvar configurações: ' + data.error);
      }
    } catch (err) {
      alert('Erro ao salvar configurações globais.');
    }
  });

  /* Lógica para Configurar e Gerenciar MFA no Perfil */
  async function checkMfaStatus() {
    const container = document.getElementById('mfaProfileBtnContainer');
    try {
      const res = await fetch('/api/admin/mfa/status', {
        headers: { 'Authorization': `Bearer ${token}` }
      });
      const data = await res.json();
      if (data.success) {
        if (data.mfaEnabled) {
          container.innerHTML = `
            <div style="display: flex; align-items: center; gap: 8px;">
              <span style="color: var(--accent-green); font-weight: 600; font-size: 0.8rem;">🟢 Ativo</span>
              <button type="button" onclick="disableMfaAction()" class="btn btn-danger" style="padding: 4px 8px; font-size: 0.75rem;">Desativar MFA</button>
            </div>
          `;
        } else {
          container.innerHTML = `
            <button type="button" onclick="startMfaSetup()" class="btn btn-primary" style="padding: 4px 10px; font-size: 0.8rem;">+ Configurar MFA</button>
          `;
        }
      }
    } catch (err) {
      container.innerHTML = '<span style="color: #ef4444; font-size: 0.75rem;">Erro ao verificar MFA</span>';
    }
  }

  async function startMfaSetup() {
    try {
      const res = await fetch('/api/admin/mfa/setup', {
        method: 'POST',
        headers: { 'Authorization': `Bearer ${token}` }
      });
      const data = await res.json();
      if (data.success) {
