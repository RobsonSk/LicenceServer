        document.getElementById('mfaQrCodeImg').src = data.qrCode;
        document.getElementById('mfaSecretText').textContent = data.secret;
        document.getElementById('mfaConfirmCode').value = '';
        document.getElementById('mfaSetupModal').style.display = 'flex';
      } else {
        alert('Erro ao iniciar configuração do MFA: ' + data.error);
      }
    } catch (err) {
      alert('Erro ao conectar com o servidor para MFA.');
    }
  }

  function closeMfaSetupModal() {
    document.getElementById('mfaSetupModal').style.display = 'none';
  }

  document.getElementById('mfaEnableForm').addEventListener('submit', async (e) => {
    e.preventDefault();
    const tokenVal = document.getElementById('mfaConfirmCode').value.trim();
    if (!tokenVal || !currentGeneratedMfaSecret) return;

    try {
      const res = await fetch('/api/admin/mfa/enable', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'Authorization': `Bearer ${token}`
        },
        body: JSON.stringify({ secret: currentGeneratedMfaSecret, token: tokenVal })
      });
