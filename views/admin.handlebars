            <th style="padding: 0.75rem 1rem;">User Agent</th>
            <th style="padding: 0.75rem 1rem; text-align: right;">Ações</th>
          </tr>
        </thead>
        <tbody id="logsTableBody">
          <tr>
            <td colspan="7" style="padding: 1.5rem; text-align: center; color: var(--text-muted);">Carregando logs de auditoria...</td>
          </tr>
        </tbody>
      </table>
    </div>

    <!-- Barra de Paginação para Logs (5 itens por página) -->
    <div id="logsPagination" style="display: flex; justify-content: space-between; align-items: center; padding: 0.75rem 1rem; border-top: 1px solid var(--border-color); font-size: 0.85rem; color: var(--text-muted); background: rgba(255,255,255,0.01);">
      <span id="logsPageInfo">Mostrando 0-0 de 0 tentativas</span>
      <div style="display: flex; gap: 8px; align-items: center;">
        <button id="btnPrevLogs" onclick="changeLogsPage(-1)" class="btn btn-secondary" style="padding: 4px 10px; font-size: 0.75rem;">← Anterior</button>
        <span id="logsPageNum" style="font-weight: 600; color: var(--accent-blue);">Página 1 de 1</span>
        <button id="btnNextLogs" onclick="changeLogsPage(1)" class="btn btn-secondary" style="padding: 4px 10px; font-size: 0.75rem;">Próximo →</button>
      </div>
    </div>
  </div>

  <!-- Seção de Blacklist de IPs Bloqueados -->
  <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem;">
    <div>
      <h2 style="font-size: 1.25rem; font-weight: 700; color: #f59e0b; display: flex; align-items: center; gap: 8px;">
        🚫 Blacklist e Histórico de IPs Bloqueados
      </h2>
      <p style="color: var(--text-muted); font-size: 0.85rem; margin-top: 2px;">Registro de bloqueios e desbloqueios com auditoria (Quem bloqueou/desbloqueou e data).</p>
    </div>
    <div style="display: flex; gap: 8px;">
      <button onclick="fetchBlockedIps()" class="btn btn-secondary" style="padding: 6px 12px; font-size: 0.8rem;">🔄 Atualizar Blacklist</button>
      <button onclick="openBlockIpModal()" class="btn btn-primary" style="padding: 6px 12px; font-size: 0.8rem;">+ Bloquear IP Manualmente</button>
    </div>
  </div>

  <div class="card" style="padding: 0; overflow: hidden; margin-bottom: 2rem;">
    <div style="overflow-x: auto;">
      <table style="width: 100%; border-collapse: collapse; text-align: left; font-size: 0.85rem;">
        <thead>
          <tr style="background-color: rgba(255,255,255,0.03); border-bottom: 1px solid var(--border-color); color: var(--text-muted);">
            <th style="padding: 0.75rem 1rem;">Endereço IP</th>
            <th style="padding: 0.75rem 1rem;">Status</th>
            <th style="padding: 0.75rem 1rem;">Motivo do Bloqueio</th>
            <th style="padding: 0.75rem 1rem;">Bloqueado por / Data</th>
            <th style="padding: 0.75rem 1rem;">Desbloqueado por / Data</th>
            <th style="padding: 0.75rem 1rem; text-align: right;">Ações</th>
          </tr>
        </thead>
        <tbody id="blockedIpsTableBody">
          <tr>
            <td colspan="6" style="padding: 1.5rem; text-align: center; color: var(--text-muted);">Carregando IPs bloqueados...</td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>
</div>

